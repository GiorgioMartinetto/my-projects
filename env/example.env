# Template di esempio: copia questo file in env/local.env e personalizza i valori.
# Non usare valori reali in questo file e non committare segreti nel repository.

# --------------------------------------------
# DATABASE CONFIGURATION
# --------------------------------------------
DATABASE_DRIVER=your_database_driver# e.g. postgresql, mysql, sqlite
DATABASE_HOST=localhost
DATABASE_PORT=your_database_port# e.g. 5432 for PostgreSQL, 3306 for MySQL
DATABASE_NAME=your_database_name
DATABASE_USER=your_database_user
DATABASE_PASSWORD=your_database_password

# Connection pool settings
DATABASE_POOL_SIZE=your_pool_size# e.g. 5
DATABASE_MAX_OVERFLOW=your_max_overflow# e.g. 10
DATABASE_POOL_TIMEOUT=your_pool_timeout# e.g. 30 seconds
DATABASE_POOL_RECYCLE=your_pool_recycle# e.g. 3600 seconds (1 hour)
DATABASE_POOL_PRE_PING=your_pre_ping_setting# true o false

# --------------------------------------------
# ACCESS CONFIGURATION
# --------------------------------------------
# Usa una chiave lunga e casuale (es. almeno 32+ caratteri).
TOKEN_SECRET_KEY=change-me-with-a-random-secret-key
TOKEN_ALGORITHM=your_token_algorithm# e.g. HS256, RS256
TOKEN_HTTP_ONLY=your_http_only_setting# true o false

# In locale puoi impostare false se non usi HTTPS.
TOKEN_SECURE=your_secure_setting# true o false
TOKEN_SAME_SITE=your_same_site_setting# e.g. strict, lax, none

# Durata del token in minuti.
TOKEN_EXPIRATION=your_token_expiration# e.g. 30 per 30 minuti